{
  "name": "saleor-factory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:guest": "docker build --target factoryd-build -f images/exedev/Dockerfile .",
    "build:image": "docker build -f images/exedev/Dockerfile -t saleor-factory-exedev:dev .",
    "build:local-guest": "docker build -f images/local/Dockerfile --output type=local,dest=dist/local-guest .",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "factory": "tsx src/cli.ts",
    "test": "pnpm test:control && pnpm test:guest",
    "test:control": "vitest run",
    "test:guest": "sh -c 'if command -v go >/dev/null 2>&1; then (cd guest && go test -race ./... && go vet ./...); else docker run --rm -v \"$PWD/guest:/src\" -w /src golang:1.26.6 sh -c \"/usr/local/go/bin/go test -race ./... && /usr/local/go/bin/go vet ./...\"; fi'",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.14.0"
}
